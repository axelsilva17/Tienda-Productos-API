<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <fallbackPackageFolders>
    <!--
      Neutraliza el fallback folder de Visual Studio configurado a nivel máquina,
      que apunta a una carpeta inexistente y rompe el restore en esta PC.
      Es inocuo en cualquier otra máquina.
    -->
    <clear />
  </fallbackPackageFolders>
</configuration>
